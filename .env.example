# Neon Postgres. Use the nyaya-dev project connection string locally.
DATABASE_URL=

# Optional. Overrides DATABASE_URL for integration tests only, so they hit a
# disposable local container instead of the shared Neon dev project. Not a
# secret -- this is the fixed value of docker-compose.test.yml's service.
# TEST_DATABASE_URL=postgresql://nyaya:nyaya@localhost:55432/nyaya_test

# Google Gemini. The only key required to run.
GEMINI_API_KEY=

# Optional. For the later Claude-vs-Gemini generation comparison.
ANTHROPIC_API_KEY=
